# Postgres connection string. Pipeline: direct URL, ingest role (a pooled URL is refused). Website: pooled URL, read-only web role
DATABASE_URL=

# OpenAI API key for extraction and eval (never expose to the web app). Without it, the pipeline collects and keeps items for later
OPENAI_API_KEY=

# Model id used for headline extraction (chosen by the extraction eval)
EXTRACTION_MODEL=gpt-5.6-luna

# Hard monthly LLM spend cap in GBP (default £3)
LLM_MONTHLY_CAP_GBP=3

# Maximum extractions per ingest run (default 150)
MAX_EXTRACTIONS_PER_RUN=150

# Contact URL or email included in outbound HTTP User-Agent strings
HTTP_CONTACT=
