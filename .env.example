# Postgres connection string. Pipeline: direct URL, ingest role (a pooled URL is refused). Website: pooled URL, read-only web role
DATABASE_URL=

# OpenAI API key for extraction and eval (never expose to the web app). Without it, the pipeline collects and keeps items for later
OPENAI_API_KEY=

# Model id used for headline extraction (chosen by the extraction eval)
EXTRACTION_MODEL=gpt-5.6-luna

# Model id for the theme check (chosen by the theme eval). Falls back to EXTRACTION_MODEL if it fails
THEME_CHECK_MODEL=gpt-5.6-luna

# Hard monthly LLM spend cap in GBP (default £3)
LLM_MONTHLY_CAP_GBP=3

# Maximum extractions per ingest run (default 150)
MAX_EXTRACTIONS_PER_RUN=150

# Contact sent in every outbound User-Agent: SignalFeed/<version> (+<HTTP_CONTACT>).
# Use an email address: SEC EDGAR needs one, and `pnpm ingest formd` refuses to run without it
HTTP_CONTACT=

# Companies House API key (pipeline only: never give it to the web app or Vercel).
# Without it, `pnpm ingest registry` is recorded as skipped
COMPANIES_HOUSE_API_KEY=

# Most Companies House requests per registry run (default 2000; the client also stays at 500 per 5 minutes)
MAX_CH_REQUESTS_PER_RUN=2000

# Most EDGAR daily indexes fetched per formd run (default 10)
MAX_EDGAR_DAYS_PER_RUN=10

# Most EDGAR requests per formd run, indexes and filings together (default 3000; the client stays at 5 a second)
MAX_EDGAR_REQUESTS_PER_RUN=3000

# Gateway to Research requests a second (default 3, at most 10; UKRI documents up to 10, to be confirmed)
GTR_REQUESTS_PER_SECOND=3

# Most organisation details fetched per grants run (default 1500; at 3 a second that is about 9 minutes)
MAX_GRANT_ORG_FETCHES_PER_RUN=1500

# Website only: set to "true" at launch to let search engines index the site.
# Unset or anything else adds noindex and a robots.txt that disallows everything
SITE_INDEXING=
